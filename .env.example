# Generate real values with:  npm run gen-env
# Never commit .env.

# HMAC key for gateway → service request signing (>= 32 chars)
INTERNAL_SECRET=
# AES-256-GCM key for encrypting PII at rest (32 bytes, base64)
FIELD_ENCRYPTION_KEY=
REDIS_PASSWORD=
# Seeded accounts
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
# client_credentials secret for the `reporting-service` OAuth client
REPORTING_CLIENT_SECRET=

# Optional
# PUBLIC_HOSTNAME=localhost
# CORS_ORIGINS=http://localhost:3000
# RATE_LIMIT_MULTIPLIER=1
# SIMULATED_DB_LATENCY_MS=0
# LOG_LEVEL=info
